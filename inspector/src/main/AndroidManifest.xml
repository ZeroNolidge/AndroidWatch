<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to read heart-rate sensors on Android 6+. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- Updates card: download new versions of the watch apps and install them. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Listing nearby cell towers (to see which mobile bands the watch can use). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Network type (4G/3G) on Android 11+. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Android 11+ hides other apps' packages unless we declare them here. -->
    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.android.vending" />
        <package android:name="com.google.android.gsf" />
        <!-- The other watch apps, to compare installed vs latest versions. -->
        <package android:name="com.androidwatch.launcher" />
        <package android:name="com.androidwatch.phonelink" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Inspector">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".InstallResultReceiver" android:exported="false" />
    </application>
</manifest>
